# ─── Supabase ──────────────────────────────────────────────────────────────
# URL y clave pública (publishable/anon) del proyecto. Se envían al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Schema donde vive GeRiAm (proyecto compartido → siempre "geriam").
NEXT_PUBLIC_SUPABASE_SCHEMA=geriam
# Clave secreta (service role). SOLO servidor (API routes / Edge Functions). Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ─── Mapas ─────────────────────────────────────────────────────────────────
# Token público de Mapbox (pk.*). Restringirlo por URL en la consola de Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxx

# ─── Organización / demo ───────────────────────────────────────────────────
# Slug de la organización por defecto (portal público y PWA).
NEXT_PUBLIC_DEFAULT_ORG=tungurahua
# Dominio de los usuarios de demostración (para identificarlos y borrarlos).
NEXT_PUBLIC_DEMO_EMAIL_DOMAIN=geriam.demo
# Activa el fallback de simulación en cliente si el cron no corre (solo demo).
NEXT_PUBLIC_DEMO_MODE=true

# ─── Integraciones (opcional) ──────────────────────────────────────────────
# Secreto compartido para /api/ingest/* (HMAC-SHA256 del body, cabecera x-geriam-signature)
GERIAM_INGEST_SECRET=cambia-esto
# Secreto para llamadas internas (cron → /api/sim/tick)
GERIAM_CRON_SECRET=cambia-esto

# ─── Notificaciones ────────────────────────────────────────────────────────
# Web Push (VAPID). Generar con: node scripts/gen-vapid.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alertas@geriam.ec
# Twilio (si faltan, las notificaciones SMS/WhatsApp quedan en modo demo: se registran sin enviarse)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
